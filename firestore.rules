rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Pomocné funkce =====
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function mail() { return request.auth.token.email.lower(); }
    function memberPath() { return /databases/$(database)/documents/members/$(mail()); }
    function isMember() { return signedIn() && exists(memberPath()); }
    function role() { return get(memberPath()).data.role; }
    // Role (v20.4 OM1 – přechod): nové manager / trener / asistent a staré trener / kustod platí současně.
    // isCoach = manager a trener (trenér zatím smí na serveru vše jako dřív; aplikace mu dává jen sport – zúží se ve v20.6 OM3).
    // isStaff = manager, trener, asistent a stará hodnota kustod (= asistent).
    function isCoach() { return isMember() && role() in ['manager', 'trener']; }
    function isStaff() { return isMember() && role() in ['manager', 'trener', 'asistent', 'kustod']; }
    // Hostující (role host, hráčka 🎟 z jiného týmu): vidí jen sebe – vlastní hráčku, docházku, předpisy a veřejné dokumenty evpub / lineuppub.
    // isTeam = člen týmu kromě hostujícího; všechna čtení týmových kolekcí jsou jen pro isTeam().
    function isHost() { return isMember() && role() == 'host'; }
    function isTeam() { return isMember() && role() != 'host'; }
    // Správce pokladny: manager a trener (do v20.6; po převodu má trenér příznak cash), nebo člen s příznakem cash (pokladník); hostující nikdy
    function isCash() { return isMember() && (role() in ['manager', 'trener'] || (role() != 'host' && get(memberPath()).data.get('cash', false) == true)); }
    // Hráčka (i hostující) smí zapisovat jen tehdy, když ji trenér propojil s hráčkou v soupisce (pole pid)
    function isPlayer() { return isMember() && role() in ['hracka', 'host'] && get(memberPath()).data.pid is string; }
    function myPid() { return get(memberPath()).data.pid; }
    // Předpis patří přihlášenému členovi (mid = jeho pid nebo tid)
    function ownsMid(mid) { return isMember() && (get(memberPath()).data.get('pid', '') == mid || get(memberPath()).data.get('tid', '') == mid); }
    // ===== Práva po modulech (matice settings/perm, OM2) =====
    // Účinná role jako v aplikaci (domain/permissions.js roleOf): stará kustod = asistent, trener bez rv 2 (před převodem) = manager.
    function roleFix(m) { return m.role == 'kustod' ? 'asistent' : ((m.role == 'trener' && m.get('rv', 0) != 2) ? 'manager' : m.role); }
    function myRole() { return roleFix(get(memberPath()).data); }
    function isMgr() { return isMember() && myRole() == 'manager'; }
    // Matice settings/perm = {v, roles: {trener|asistent|hracka: {modul: {r, e, c, d}}}, by, at}; chybějící dokument nebo hodnota = výchozí.
    // Výchozí matice = DEFAULT_PERMS z domain/permissions.js (shodu hlídá test tests/perm-matrix.test.js).
    function permPath() { return /databases/$(database)/documents/settings/perm; }
    function permDef() { return {
      'trener': {'events': {'r': true, 'e': true, 'c': true, 'd': true}, 'matches': {'r': true, 'e': true, 'c': true, 'd': true}, 'att': {'r': true, 'e': true, 'c': false, 'd': true}, 'lines': {'r': true, 'e': true, 'c': false, 'd': true}, 'roster': {'r': true, 'e': true, 'c': false, 'd': true}, 'staff': {'r': true, 'e': true, 'c': false, 'd': true}, 'opp': {'r': true, 'e': true, 'c': false, 'd': true}, 'stats': {'r': true, 'e': false, 'c': false, 'd': false}, 'attview': {'r': true, 'e': false, 'c': false, 'd': false}, 'members': {'r': false, 'e': false, 'c': false, 'd': false}, 'budget': {'r': false, 'e': false, 'c': false, 'd': false}, 'app': {'r': true, 'e': false, 'c': false, 'd': false}},
      'asistent': {'events': {'r': true, 'e': true, 'c': true, 'd': true}, 'matches': {'r': true, 'e': true, 'c': true, 'd': true}, 'att': {'r': true, 'e': true, 'c': false, 'd': true}, 'lines': {'r': true, 'e': true, 'c': false, 'd': true}, 'roster': {'r': true, 'e': false, 'c': false, 'd': false}, 'staff': {'r': true, 'e': false, 'c': false, 'd': false}, 'opp': {'r': true, 'e': true, 'c': false, 'd': true}, 'stats': {'r': true, 'e': false, 'c': false, 'd': false}, 'attview': {'r': true, 'e': false, 'c': false, 'd': false}, 'members': {'r': false, 'e': false, 'c': false, 'd': false}, 'budget': {'r': false, 'e': false, 'c': false, 'd': false}, 'app': {'r': true, 'e': false, 'c': false, 'd': false}},
      'hracka': {'events': {'r': true, 'e': false, 'c': false, 'd': false}, 'matches': {'r': true, 'e': false, 'c': false, 'd': false}, 'att': {'r': false, 'e': false, 'c': false, 'd': false}, 'lines': {'r': true, 'e': false, 'c': false, 'd': false}, 'roster': {'r': true, 'e': false, 'c': false, 'd': false}, 'staff': {'r': true, 'e': false, 'c': false, 'd': false}, 'opp': {'r': true, 'e': false, 'c': false, 'd': false}, 'stats': {'r': true, 'e': false, 'c': false, 'd': false}, 'attview': {'r': true, 'e': false, 'c': false, 'd': false}, 'members': {'r': false, 'e': false, 'c': false, 'd': false}, 'budget': {'r': false, 'e': false, 'c': false, 'd': false}, 'app': {'r': false, 'e': false, 'c': false, 'd': false}}
    }; }
    function permSet(r, mod, act) { return exists(permPath()) ? get(permPath()).data.get(['roles', r, mod, act], null) : null; }
    function permVal(v, r, mod, act) { return v is bool ? v : permDef()[r][mod][act]; }
    function canAs(r, mod, act) { return r == 'manager' || (r in ['trener', 'asistent', 'hracka'] && permVal(permSet(r, mod, act), r, mod, act)); }
    // Smí přihlášený člen akci v modulu (r číst, e upravovat, c rušit, d mazat)? Manager vždy, hostující nikdy.
    function can(mod, act) { return isMember() && canAs(myRole(), mod, act); }
    // Úprava události / zápasu: pole cancelled = rušit (c), jen pole lines (pětky tréninku) = formace, ostatní pole = upravovat (e)
    function chKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function evUpdate(mod) {
      return (can(mod, 'e') && !chKeys().hasAny(['cancelled'])) || (can(mod, 'c') && chKeys().hasOnly(['cancelled']))
        || (can('lines', 'e') && chKeys().hasOnly(['lines']));
    }
    // Zápis matice: jen manager, tvar {v, roles, by, at}, role jen trener / asistent / hracka, by = jeho e-mail
    function permSettingsOk() {
      return isMgr() && request.resource.data.keys().hasOnly(['v', 'roles', 'by', 'at']) && request.resource.data.roles is map
        && request.resource.data.roles.keys().hasOnly(['trener', 'asistent', 'hracka']) && request.resource.data.get('by', mail()) == mail();
    }
    // Pole, které smí v dokumentu události / zápasu měnit i pokladník: příznak ss (vyúčtováno); náklady a vyúčtování jsou v evcash.
    function cashFieldsOnly() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ss']); }
    // Stará citlivá pole (dnes v soukromých kolekcích plpay, staffpay, attnote): nový dokument je nesmí obsahovat,
    // změna dokumentu je nesmí přidat ani změnit – smazat je jde (úklid v ⚙️ → Kontrola dat).
    function noKeys(ks) { return !request.resource.data.keys().hasAny(ks); }
    function keepOut(ks) { return !request.resource.data.diff(resource.data).addedKeys().hasAny(ks) && !request.resource.data.diff(resource.data).changedKeys().hasAny(ks); }

    // ===== Účty týmu pro QR platby: princip čtyř očí =====
    // iban / iban2 = platné účty, ibanBy = kdo změnu navrhl, ibanOk = kdo ji potvrdil, ibanAt = kdy, ibanPend = čekající návrh {iban, iban2, by, at}.
    // Návrh smí podat jen manager / trenér (isCoach, pod svým e-mailem), potvrdit jen JINÝ správce pokladny a jen přesně navržené účty.
    function sNew(k) { return request.resource.data.get(k, ''); }
    function sOld(k) { return resource.data.get(k, ''); }
    function pendNew() { return request.resource.data.get('ibanPend', null); }
    function pendOld() { return resource.data.get('ibanPend', null); }
    function accSame() { return sNew('iban') == sOld('iban') && sNew('iban2') == sOld('iban2') && sNew('ibanBy') == sOld('ibanBy') && sNew('ibanOk') == sOld('ibanOk') && sNew('ibanAt') == sOld('ibanAt'); }
    function pendByMe() { return pendNew() != null && isCoach() && pendNew().by == mail(); }
    function cashSettingsUpdate() {
      return isCash() && (
        (accSame() && pendNew() == pendOld())                     // běžná změna nastavení (účty beze změny)
        || (accSame() && pendNew() == null)                       // zrušení / zamítnutí návrhu
        || (accSame() && pendByMe())                              // nový návrh – jen trenér
        || (pendOld() != null && pendNew() == null                // potvrzení jiným správcem přesně podle návrhu
            && pendOld().by != mail()
            && sNew('iban') == pendOld().get('iban', '') && sNew('iban2') == pendOld().get('iban2', '')
            && sNew('ibanBy') == pendOld().by && sNew('ibanOk') == mail()));
    }
    // Nový dokument nastavení pokladny: bez účtů, nejvýš s návrhem trenéra
    function cashSettingsCreate() {
      return isCash() && sNew('iban') == '' && sNew('iban2') == '' && sNew('ibanBy') == '' && sNew('ibanOk') == '' && sNew('ibanAt') == ''
        && (pendNew() == null || pendByMe());
    }

    // ===== Brána verze (settings/app): {minVer, minBy, minAt} – minimální verze aplikace, která smí zapisovat =====
    // Nastavuje jen manager / trenér (isCoach); minVer = číslo verze (např. 18.8), minBy = jeho e-mail. Dokument nejde smazat.
    function appSettingsOk() {
      return isCoach() && request.resource.data.keys().hasOnly(['minVer', 'minBy', 'minAt'])
        && request.resource.data.minVer is string && request.resource.data.minVer.matches('^[0-9]+([.][0-9]+){0,2}$')
        && request.resource.data.get('minBy', mail()) == mail();
    }

    // ===== Členové týmu: role, propojení (pid, tid) a příznak pokladníka (cash) =====
    // Manager (a do v20.6 trener) spravuje všechny členy, převádí role a zapisuje rv. Pokladník jen členy s rolí hracka – před změnou i po ní –
    // a nikdy vlastní dokument (jinak by si mohl dát roli asistent a získat sportovní zápis). Posledního managera hlídá aplikace.
    function cashierMember(email, d) { return isCash() && email != mail() && d.role == 'hracka'; }
    match /members/{email} {
      allow read: if signedIn() && (email == mail() || isCoach() || isCash());
      allow create: if isCoach() || cashierMember(email, request.resource.data);
      allow update: if isCoach() || (cashierMember(email, request.resource.data) && cashierMember(email, resource.data));
      allow delete: if isCoach() || cashierMember(email, resource.data);
    }

    // ===== Soupiska: spravuje trenér; kustod smí měnit jen stav (st) =====
    // Platební pole (grp, fx, ex, note) jsou v plpay/{pid} (spravuje je správce pokladny); v soupisce je nejde zapsat, jen smazat.
    // Příznak guest (hostující 🎟) zapisuje trenér; hostující čte jen svůj dokument.
    match /players/{id} {
      allow read: if isTeam() || (isHost() && id == myPid());
      allow create: if isCoach() && noKeys(['grp', 'fx', 'ex', 'note']);
      allow delete: if isCoach();
      allow update: if keepOut(['grp', 'fx', 'ex', 'note']) && (isCoach()
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st'])));
    }

    // ===== Realizační tým: čtou všichni členové, spravuje trenér =====
    // Plat je ve staffpay/{tid} (spravuje ho správce pokladny); pole pay v dokumentu týmu nejde zapsat, jen smazat.
    match /staff/{id} {
      allow read: if isTeam();
      allow create: if isCoach() && noKeys(['pay']);
      allow delete: if isCoach();
      allow update: if isCoach() && keepOut(['pay']);
    }

    // ===== Zápasy, soupeři: podle matice práv (výchozí trenér i asistent); u zápasu smí pokladník měnit jen příznak ss. Číst smí členové týmu =====
    // Zrušení (pole cancelled) = akce rušit, smazání = mazat, ostatní změny = upravovat (evUpdate).
    match /matches/{id} {
      allow read: if isTeam();
      allow create: if can('matches', 'e');
      allow delete: if can('matches', 'd');
      allow update: if evUpdate('matches') || (isCash() && cashFieldsOnly());
    }
    match /opponents/{id} {
      allow read: if isTeam();
      allow create, update: if can('opp', 'e');
      allow delete: if can('opp', 'd');
    }

    // ===== Nastavení: základní formace trenér a asistent, settings/cash (šablony, kategorie) správce pokladny; účty jen přes návrh a potvrzení;
    // settings/app (brána verze) manager a do v20.6 trenér; settings/perm (matice práv) jen manager; čtou členové týmu (ne hostující),
    // hostující jen cash (účet pro QR), events (sraz) a app. settings/cash ani settings/app nejde smazat =====
    match /settings/{id} {
      allow read: if isTeam() || (isHost() && id in ['cash', 'events', 'app']);
      allow create: if id == 'cash' ? cashSettingsCreate() : (id == 'app' ? appSettingsOk() : (id == 'perm' ? permSettingsOk() : isStaff()));
      allow update: if id == 'cash' ? cashSettingsUpdate() : (id == 'app' ? appSettingsOk() : (id == 'perm' ? permSettingsOk() : isStaff()));
      allow delete: if id != 'cash' && id != 'app' && (id == 'perm' ? isMgr() : isStaff());
    }

    // ===== Tréninky (události): čtou členové týmu, spravuje se podle matice práv (výchozí trenér a asistent); pokladník jen příznak ss =====
    // Zrušení (pole cancelled) = rušit, pětky (jen pole lines) = formace, smazání = mazat, ostatní změny = upravovat.
    match /events/{id} {
      allow read: if isTeam();
      allow create: if can('events', 'e');
      allow delete: if can('events', 'd');
      allow update: if evUpdate('events') || (isCash() && cashFieldsOnly());
    }

    // ===== Série tréninků (definice opakování): čtou členové, zapisuje kdo smí upravovat události; události série jsou v events (pole ser) =====
    match /series/{id} {
      allow read: if isTeam();
      allow create, update: if can('events', 'e');
      allow delete: if can('events', 'd');
    }

    // ===== Vyúčtování událostí (náklady, kdo platí, snapshot): jen správci pokladny; id = id události nebo zápasu =====
    match /evcash/{id} { allow read, write: if isCash(); }
    // Cena uzavřené události na hlavu evprice/{id} = {ym, date, tpl, head: {monthly, single, exempt}} (před koeficientem, 0 = skupina neplatí):
    // čte každý člen (Moje platby – porovnání způsobu placení), zapisuje správce pokladny; celkové náklady ani dodavatelé tu nejsou
    function priceOk(d) { return d.keys().hasOnly(['ym', 'date', 'tpl', 'head']) && d.ym is string && d.date is string && d.tpl is string && d.head is map; }
    match /evprice/{id} {
      allow read: if isMember();
      allow create, update: if isCash() && priceOk(request.resource.data);
      allow delete: if isCash();
    }

    // ===== Rozpočet sezóny budget/{sezóna} (id "RRRR-RR", období 1. 8. – 30. 6.): čte a zapisuje jen správce pokladny =====
    // Pole plánu (parametry, položky, platy, ostatní), kdo / kdy uložil, schválení approved = {data, sum, by, at} a úpravy rev (seznam);
    // sezóna v dokumentu musí odpovídat id. Schválenou verzi nejde změnit ani odebrat, úpravy jen přidávat; smazat jde jen neschválený (trenér).
    function budgetOk(id, d) { return d.keys().hasOnly(['season', 'par', 'items', 'sal', 'other', 'by', 'at', 'approved', 'rev']) && d.season == id && d.par is map && d.items is list && d.sal is list && d.other is list
      && (!('approved' in d) || (d.approved is map && d.approved.keys().hasOnly(['data', 'sum', 'by', 'at']) && d.approved.data is map))
      && (!('rev' in d) || d.rev is list); }
    function budgetKeep(o, d) { return (!('approved' in o) || (('approved' in d) && d.approved == o.approved))
      && (!('rev' in o) || (('rev' in d) && d.rev.size() >= o.rev.size())); }
    match /budget/{id} {
      allow read: if isCash();
      allow create: if isCash() && id.matches('^[0-9]{4}-[0-9]{2}$') && budgetOk(id, request.resource.data);
      allow update: if isCash() && id.matches('^[0-9]{4}-[0-9]{2}$') && budgetOk(id, request.resource.data) && budgetKeep(resource.data, request.resource.data);
      allow delete: if isCoach() && !('approved' in resource.data);
    }

    // ===== Docházka: dokument {eid}_{pid} s poli eid, pid, st, at, by =====
    // Důvod omluvy je v attnote/{eid}_{pid}; pole reason v docházce nejde zapsat, jen smazat (čte ji každý člen).
    // pid je hráčka nebo člen realizačního týmu. Trenér a kustod zapisují za kohokoli; hráčka jen svůj dokument (pid z jejího členství, id = eid_pid)
    // Docházka: odpověď st; nos = 🚫 nedorazila bez omluvy – nastavuje a ruší jen trenér / kustod, hráčka značku nezaloží, nezmění ani nesmaže
    // abs = id 🏖 nepřítomnosti, ze které omluva vznikla (zapisuje ji vlastník i trenér / kustod). Hostující čte jen své odpovědi.
    function nosKeep() { return request.resource.data.get('nos', null) == resource.data.get('nos', null); }
    match /attendance/{id} {
      allow read: if isTeam() || (isHost() && resource.data.pid == myPid());
      allow create: if noKeys(['reason']) && (isStaff() || (isPlayer() && noKeys(['nos'])
        && request.resource.data.pid == myPid()
        && id == request.resource.data.eid + '_' + myPid()));
      allow update: if keepOut(['reason']) && (isStaff() || (isPlayer() && nosKeep()
        && request.resource.data.pid == myPid()
        && id == request.resource.data.eid + '_' + myPid()));
      allow delete: if isStaff() || (isPlayer() && resource.data.pid == myPid() && !('nos' in resource.data));
    }

    // ===== Soukromé kolekce: citlivá data čte jen vlastník a správci =====
    // Důvod omluvy attnote/{eid}_{mid} = {eid, mid, reason} (zdravotní údaje): čte vlastník (mid = jeho pid / tid) a trenér / kustod.
    // Zapisuje trenér a kustod za kohokoli, hráčka jen svůj (mid z jejího členství); id = eid_mid, jen tato tři pole.
    function noteOk(id, d) { return d.keys().hasOnly(['eid', 'mid', 'reason']) && d.reason is string && id == d.eid + '_' + d.mid; }
    match /attnote/{id} {
      allow read: if isStaff() || ownsMid(resource.data.mid);
      allow create, update: if noteOk(id, request.resource.data) && (isStaff() || (isPlayer() && request.resource.data.mid == myPid()));
      allow delete: if isStaff() || (isPlayer() && resource.data.mid == myPid());
    }
    // Plat člena realizačního týmu staffpay/{tid} = {m, amt}: čte a zapisuje správce pokladny, číst smí i člen sám (tid z členství)
    match /staffpay/{id} {
      allow read: if isCash() || ownsMid(id);
      allow create, update: if isCash() && request.resource.data.keys().hasOnly(['m', 'amt']);
      allow delete: if isCash();
    }
    // Platební pole hráčky plpay/{pid} = {grp, fx, ex, note, grpH}: čte a zapisuje správce pokladny, číst smí i hráčka sama (pid z členství);
    // grpH = historie způsobu placení [{ym, grp}] (seznam)
    match /plpay/{id} {
      allow read: if isCash() || (isPlayer() && id == myPid());
      allow create, update: if isCash() && request.resource.data.keys().hasOnly(['grp', 'fx', 'ex', 'note', 'grpH']) && request.resource.data.get('grpH', []) is list;
      allow delete: if isCash();
    }

    // ===== Žádosti členů requests/{id} (kind "pay" = změna způsobu placení, kind "att" = změna účasti po uzávěrce) =====
    // Hráčka vytvoří jen vlastní otevřenou žádost o placení pod svým e-mailem a smí ji smazat (zrušit), dokud je otevřená.
    // Žádost o změnu účasti podá člen (hráčka, hostující, člen týmu) za sebe (mid = jeho pid / tid); vyřizuje ji trenér / kustod.
    // Čte vlastník, správce pokladny a u žádostí o účast trenér / kustod; vyřízení jen otevřené žádosti:
    // mění pouze st (ok / no), reply, doneBy (jeho e-mail), doneAt.
    function reqPayOk(d) {
      return d.keys().hasOnly(['kind', 'mid', 'at', 'by', 'st', 'from', 'to', 'ym', 'note'])
        && d.kind == 'pay' && d.st == 'open' && d.mid == myPid() && d.by == mail() && d.at is string
        && d.from in ['monthly', 'single'] && d.to in ['monthly', 'single'] && d.ym is string && d.note is string && d.note.size() <= 300;
    }
    function reqAttOk(d) {
      return d.keys().hasOnly(['kind', 'mid', 'at', 'by', 'st', 'eid', 'want', 'reason', 'abs'])
        && d.kind == 'att' && d.st == 'open' && ownsMid(d.mid) && d.by == mail() && d.at is string && d.eid is string
        && d.want in ['yes', 'no', 'maybe'] && d.reason is string && d.reason.size() <= 300 && d.get('abs', '') is string;
    }
    function reqDone() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'reply', 'doneBy', 'doneAt'])
        && resource.data.st == 'open' && request.resource.data.st in ['ok', 'no'] && request.resource.data.doneBy == mail();
    }
    match /requests/{id} {
      allow read: if isCash() || ownsMid(resource.data.mid) || (isStaff() && resource.data.kind == 'att');
      allow create: if (isPlayer() && reqPayOk(request.resource.data)) || reqAttOk(request.resource.data);
      allow update: if (isCash() && resource.data.kind == 'pay' && !ownsMid(resource.data.mid) && reqDone())
        || (isStaff() && resource.data.kind == 'att' && reqDone());
      allow delete: if isCash() || (isStaff() && resource.data.kind == 'att') || (ownsMid(resource.data.mid) && resource.data.st == 'open');
    }

    // ===== 🏖 Nepřítomnost člena absence/{id} = {mid, kind, from, to, note, by, at} (druh nemoc = zdravotní údaj) =====
    // Čte vlastník (mid = jeho pid / tid) a trenér / kustod; zakládá, mění a maže vlastník za sebe (by = jeho e-mail),
    // trenér / kustod za kohokoli (i obnova ze zálohy s původním by).
    function absOk(d) {
      return d.keys().hasOnly(['mid', 'kind', 'from', 'to', 'note', 'by', 'at']) && d.mid is string && d.kind in ['vac', 'sick', 'other']
        && d.from is string && d.to is string && d.from <= d.to && d.note is string && d.note.size() <= 300 && d.by is string && d.at is string;
    }
    function absMine(d) { return ownsMid(d.mid) && d.by == mail(); }
    match /absence/{id} {
      allow read: if isStaff() || ownsMid(resource.data.mid);
      allow create: if absOk(request.resource.data) && (isStaff() || absMine(request.resource.data));
      allow update: if absOk(request.resource.data) && (isStaff() || (ownsMid(resource.data.mid) && absMine(request.resource.data)));
      allow delete: if isStaff() || ownsMid(resource.data.mid);
    }

    // ===== Veřejné dokumenty pro hostující (zapisuje aplikace trenéra / kustoda, views/auto-sync.js) =====
    // evpub/{id} = hlavička události bez odpovědí, nákladů a statistik – čte každý člen včetně hostujících.
    // lineuppub/{id} = pětky / formace jako jména – čtou členové týmu a hostující jen u události, kde má odpověď „Jdu“.
    function pubOk(d) { return d.keys().hasOnly(['k', 'date', 'time', 'place', 'dl', 'meet', 'title', 'end', 'note', 'opp', 'home', 'cancelled']) && d.k in ['t', 'm'] && d.date is string; }
    function attPath(eid) { return /databases/$(database)/documents/attendance/$(eid + '_' + myPid()); }
    function hostGoing(eid) { return isHost() && exists(attPath(eid)) && get(attPath(eid)).data.st == 'yes'; }
    match /evpub/{id} {
      allow read: if isMember();
      allow create, update: if isStaff() && pubOk(request.resource.data);
      allow delete: if isStaff();
    }
    match /lineuppub/{id} {
      allow read: if isTeam() || hostGoing(id);
      allow create, update: if isStaff() && request.resource.data.keys().hasOnly(['k', 'date', 'rows']) && request.resource.data.rows is list;
      allow delete: if isStaff();
    }

    // ===== Žádosti o přijetí do týmu joinreq/{email} (id = e-mail účtu Google malými písmeny) =====
    // Založit smí jen přihlášený účet BEZ členství a jen sám za sebe, jen pole formuláře se st 'open'. Po vyřízení trenérem
    // (zamítnutí, odebraný přístup) smí poslat novou žádost nejdřív 24 h po vyřízení (doneMs). Čte vlastník a trenér;
    // vyřizuje (st, reply, doneBy, doneMs, pid / tid) a maže trenér, uchazeč smí smazat (zrušit) jen otevřenou žádost.
    function joinForm(email, d) {
      return d.keys().hasOnly(['email', 'nick', 'num', 'kind', 'note', 'st', 'at'])
        && d.email == email && d.st == 'open' && d.at is string
        && d.nick is string && d.nick.size() > 0 && d.nick.size() <= 40
        && d.num is string && d.num.matches('^([1-9][0-9]?)?$')
        && d.kind in ['hracka', 'staff'] && d.note is string && d.note.size() <= 300;
    }
    function joinOwner(email) { return signedIn() && email == mail() && !isMember(); }
    match /joinreq/{email} {
      allow read: if signedIn() && (email == mail() || isCoach());
      allow create: if joinOwner(email) && joinForm(email, request.resource.data);
      allow update: if isCoach() || (joinOwner(email) && resource.data.st in ['no', 'ok']
        && request.time.toMillis() > resource.data.get('doneMs', 0) + 86400000 && joinForm(email, request.resource.data));
      allow delete: if isCoach() || (signedIn() && email == mail() && resource.data.st == 'open');
    }

    // ===== Pokladna: předpisy (události i měsíční příspěvky) čte vlastník (mid = jeho pid / tid) a správci; příjmy, výdaje, platy a audit jen správci =====
    // Člen musí předpisy číst dotazem s podmínkou mid == jeho pid / tid (aplikace to dělá)
    match /charges/{id} {
      allow read: if isCash() || ownsMid(resource.data.mid);
      allow write: if isCash();
    }
    // Souhrn dlužníků: dokument {mid, since, dues: [{d, x}]} BEZ částek (splatnosti nezaplacených předpisů a příznak výjimky).
    // Čtou členové týmu (značka ⛓ v Docházce), zapisuje jen správce pokladny ve stejné dávce jako změny předpisů; id dokumentu = mid
    match /debtors/{id} {
      allow read: if isTeam();
      allow create, update: if isCash() && request.resource.data.mid == id
        && request.resource.data.keys().hasOnly(['mid', 'since', 'dues'])
        && request.resource.data.since is string && request.resource.data.dues is list;
      allow delete: if isCash();
    }
    match /cash/{id} { allow read, write: if isCash(); }
    // Audit log se jen přidává (nejde měnit ani mazat)
    match /audit/{id} {
      allow read: if isCash();
      allow create: if isCash();
    }
    // Ostatní kolekce (i neznámé) pravidla nepovolují – kdo je nemá výslovně uvedené výše, nečte ani nezapisuje.
  }
}
