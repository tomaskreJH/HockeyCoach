rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Pomocné funkce =====
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function mail() { return request.auth.token.email.lower(); }
    function memberPath() { return /databases/$(database)/documents/members/$(mail()); }
    function isMember() { return signedIn() && exists(memberPath()); }
    function role() { return get(memberPath()).data.role; }
    function isCoach() { return isMember() && role() == 'trener'; }
    function isStaff() { return isMember() && role() in ['trener', 'kustod']; }
    // Správce pokladny: trenér, nebo člen s příznakem cash (pokladník)
    function isCash() { return isMember() && (role() == 'trener' || get(memberPath()).data.get('cash', false) == true); }
    // Hráčka smí zapisovat jen tehdy, když ji trenér propojil s hráčkou v soupisce (pole pid)
    function isPlayer() { return isMember() && role() == 'hracka' && get(memberPath()).data.pid is string; }
    function myPid() { return get(memberPath()).data.pid; }
    // Předpis patří přihlášenému členovi (mid = jeho pid nebo tid)
    function ownsMid(mid) { return isMember() && (get(memberPath()).data.get('pid', '') == mid || get(memberPath()).data.get('tid', '') == mid); }
    // Pole, které smí v dokumentu události / zápasu měnit i pokladník: příznak ss (vyúčtováno); náklady a vyúčtování jsou v evcash.
    function cashFieldsOnly() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ss']); }
    // Stará citlivá pole (dnes v soukromých kolekcích plpay, staffpay, attnote): nový dokument je nesmí obsahovat,
    // změna dokumentu je nesmí přidat ani změnit – smazat je jde (úklid v ⚙️ → Kontrola dat).
    function noKeys(ks) { return !request.resource.data.keys().hasAny(ks); }
    function keepOut(ks) { return !request.resource.data.diff(resource.data).addedKeys().hasAny(ks) && !request.resource.data.diff(resource.data).changedKeys().hasAny(ks); }

    // ===== Účty týmu pro QR platby: princip čtyř očí =====
    // iban / iban2 = platné účty, ibanBy = kdo změnu navrhl, ibanOk = kdo ji potvrdil, ibanAt = kdy, ibanPend = čekající návrh {iban, iban2, by, at}.
    // Návrh smí podat jen trenér (pod svým e-mailem), potvrdit jen JINÝ správce pokladny a jen přesně navržené účty.
    function sNew(k) { return request.resource.data.get(k, ''); }
    function sOld(k) { return resource.data.get(k, ''); }
    function pendNew() { return request.resource.data.get('ibanPend', null); }
    function pendOld() { return resource.data.get('ibanPend', null); }
    function accSame() { return sNew('iban') == sOld('iban') && sNew('iban2') == sOld('iban2') && sNew('ibanBy') == sOld('ibanBy') && sNew('ibanOk') == sOld('ibanOk') && sNew('ibanAt') == sOld('ibanAt'); }
    function pendByMe() { return pendNew() != null && isCoach() && pendNew().by == mail(); }
    function cashSettingsUpdate() {
      return isCash() && (
        (accSame() && pendNew() == pendOld())                     // běžná změna nastavení (účty beze změny)
        || (accSame() && pendNew() == null)                       // zrušení / zamítnutí návrhu
        || (accSame() && pendByMe())                              // nový návrh – jen trenér
        || (pendOld() != null && pendNew() == null                // potvrzení jiným správcem přesně podle návrhu
            && pendOld().by != mail()
            && sNew('iban') == pendOld().get('iban', '') && sNew('iban2') == pendOld().get('iban2', '')
            && sNew('ibanBy') == pendOld().by && sNew('ibanOk') == mail()));
    }
    // Nový dokument nastavení pokladny: bez účtů, nejvýš s návrhem trenéra
    function cashSettingsCreate() {
      return isCash() && sNew('iban') == '' && sNew('iban2') == '' && sNew('ibanBy') == '' && sNew('ibanOk') == '' && sNew('ibanAt') == ''
        && (pendNew() == null || pendByMe());
    }

    // ===== Brána verze (settings/app): {minVer, minBy, minAt} – minimální verze aplikace, která smí zapisovat =====
    // Nastavuje jen trenér; minVer = číslo verze (např. 18.8), minBy = jeho e-mail. Dokument nejde smazat.
    function appSettingsOk() {
      return isCoach() && request.resource.data.keys().hasOnly(['minVer', 'minBy', 'minAt'])
        && request.resource.data.minVer is string && request.resource.data.minVer.matches('^[0-9]+([.][0-9]+){0,2}$')
        && request.resource.data.get('minBy', mail()) == mail();
    }

    // ===== Členové týmu: role, propojení (pid, tid) a příznak pokladníka (cash) =====
    // Trenér spravuje všechny členy. Pokladník (bez role trenér) jen členy s rolí hracka – před změnou i po ní –
    // a nikdy vlastní dokument (jinak by si mohl dát roli kustod a získat sportovní zápis).
    function cashierMember(email, d) { return isCash() && email != mail() && d.role == 'hracka'; }
    match /members/{email} {
      allow read: if signedIn() && (email == mail() || isCoach() || isCash());
      allow create: if isCoach() || cashierMember(email, request.resource.data);
      allow update: if isCoach() || (cashierMember(email, request.resource.data) && cashierMember(email, resource.data));
      allow delete: if isCoach() || cashierMember(email, resource.data);
    }

    // ===== Soupiska: spravuje trenér; kustod smí měnit jen stav (st) =====
    // Platební pole (grp, fx, ex, note) jsou v plpay/{pid} (spravuje je správce pokladny); v soupisce je nejde zapsat, jen smazat.
    match /players/{id} {
      allow read: if isMember();
      allow create: if isCoach() && noKeys(['grp', 'fx', 'ex', 'note']);
      allow delete: if isCoach();
      allow update: if keepOut(['grp', 'fx', 'ex', 'note']) && (isCoach()
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st'])));
    }

    // ===== Realizační tým: čtou všichni členové, spravuje trenér =====
    // Plat je ve staffpay/{tid} (spravuje ho správce pokladny); pole pay v dokumentu týmu nejde zapsat, jen smazat.
    match /staff/{id} {
      allow read: if isMember();
      allow create: if isCoach() && noKeys(['pay']);
      allow delete: if isCoach();
      allow update: if isCoach() && keepOut(['pay']);
    }

    // ===== Zápasy, soupeři: trenér i kustod; u zápasu smí pokladník měnit jen příznak ss. Číst smí všichni členové (statistiky jsou pro celý tým) =====
    match /matches/{id} {
      allow read: if isMember();
      allow create, delete: if isStaff();
      allow update: if isStaff() || (isCash() && cashFieldsOnly());
    }
    match /opponents/{id} { allow read: if isMember(); allow write: if isStaff(); }

    // ===== Nastavení: základní formace trenér a kustod, settings/cash (šablony, kategorie) správce pokladny; účty jen přes návrh a potvrzení;
    // settings/app (brána verze) jen trenér; čtou všichni členové. settings/cash ani settings/app nejde smazat =====
    match /settings/{id} {
      allow read: if isMember();
      allow create: if id == 'cash' ? cashSettingsCreate() : (id == 'app' ? appSettingsOk() : isStaff());
      allow update: if id == 'cash' ? cashSettingsUpdate() : (id == 'app' ? appSettingsOk() : isStaff());
      allow delete: if id != 'cash' && id != 'app' && isStaff();
    }

    // ===== Tréninky (události): čtou všichni členové, spravuje trenér a kustod; pokladník jen příznak ss =====
    match /events/{id} {
      allow read: if isMember();
      allow create, delete: if isStaff();
      allow update: if isStaff() || (isCash() && cashFieldsOnly());
    }

    // ===== Série tréninků (definice opakování): čtou členové, zapisuje trenér a kustod; události série jsou v events (pole ser) =====
    match /series/{id} {
      allow read: if isMember();
      allow write: if isStaff();
    }

    // ===== Vyúčtování událostí (náklady, kdo platí, snapshot): jen správci pokladny; id = id události nebo zápasu =====
    match /evcash/{id} { allow read, write: if isCash(); }
    // Cena uzavřené události na hlavu evprice/{id} = {ym, date, tpl, head: {monthly, single, exempt}} (před koeficientem, 0 = skupina neplatí):
    // čte každý člen (Moje platby – porovnání způsobu placení), zapisuje správce pokladny; celkové náklady ani dodavatelé tu nejsou
    function priceOk(d) { return d.keys().hasOnly(['ym', 'date', 'tpl', 'head']) && d.ym is string && d.date is string && d.tpl is string && d.head is map; }
    match /evprice/{id} {
      allow read: if isMember();
      allow create, update: if isCash() && priceOk(request.resource.data);
      allow delete: if isCash();
    }

    // ===== Docházka: dokument {eid}_{pid} s poli eid, pid, st, at, by =====
    // Důvod omluvy je v attnote/{eid}_{pid}; pole reason v docházce nejde zapsat, jen smazat (čte ji každý člen).
    // pid je hráčka nebo člen realizačního týmu. Trenér a kustod zapisují za kohokoli; hráčka jen svůj dokument (pid z jejího členství, id = eid_pid)
    match /attendance/{id} {
      allow read: if isMember();
      allow create: if noKeys(['reason']) && (isStaff() || (isPlayer()
        && request.resource.data.pid == myPid()
        && id == request.resource.data.eid + '_' + myPid()));
      allow update: if keepOut(['reason']) && (isStaff() || (isPlayer()
        && request.resource.data.pid == myPid()
        && id == request.resource.data.eid + '_' + myPid()));
      allow delete: if isStaff() || (isPlayer() && resource.data.pid == myPid());
    }

    // ===== Soukromé kolekce: citlivá data čte jen vlastník a správci =====
    // Důvod omluvy attnote/{eid}_{mid} = {eid, mid, reason} (zdravotní údaje): čte vlastník (mid = jeho pid / tid) a trenér / kustod.
    // Zapisuje trenér a kustod za kohokoli, hráčka jen svůj (mid z jejího členství); id = eid_mid, jen tato tři pole.
    function noteOk(id, d) { return d.keys().hasOnly(['eid', 'mid', 'reason']) && d.reason is string && id == d.eid + '_' + d.mid; }
    match /attnote/{id} {
      allow read: if isStaff() || ownsMid(resource.data.mid);
      allow create, update: if noteOk(id, request.resource.data) && (isStaff() || (isPlayer() && request.resource.data.mid == myPid()));
      allow delete: if isStaff() || (isPlayer() && resource.data.mid == myPid());
    }
    // Plat člena realizačního týmu staffpay/{tid} = {m, amt}: čte a zapisuje správce pokladny, číst smí i člen sám (tid z členství)
    match /staffpay/{id} {
      allow read: if isCash() || ownsMid(id);
      allow create, update: if isCash() && request.resource.data.keys().hasOnly(['m', 'amt']);
      allow delete: if isCash();
    }
    // Platební pole hráčky plpay/{pid} = {grp, fx, ex, note, grpH}: čte a zapisuje správce pokladny, číst smí i hráčka sama (pid z členství);
    // grpH = historie způsobu placení [{ym, grp}] (seznam)
    match /plpay/{id} {
      allow read: if isCash() || (isPlayer() && id == myPid());
      allow create, update: if isCash() && request.resource.data.keys().hasOnly(['grp', 'fx', 'ex', 'note', 'grpH']) && request.resource.data.get('grpH', []) is list;
      allow delete: if isCash();
    }

    // ===== Žádosti členů requests/{id} (kind "pay" = změna způsobu placení; druh "att" doplní fáze W) =====
    // Hráčka vytvoří jen vlastní otevřenou žádost o placení pod svým e-mailem a smí ji smazat (zrušit), dokud je otevřená.
    // Čte vlastník a správce pokladny; žádost o placení vyřizuje jen správce pokladny (ne vlastní žádost) a jen otevřenou:
    // mění pouze st (ok / no), reply, doneBy (jeho e-mail), doneAt.
    function reqPayOk(d) {
      return d.keys().hasOnly(['kind', 'mid', 'at', 'by', 'st', 'from', 'to', 'ym', 'note'])
        && d.kind == 'pay' && d.st == 'open' && d.mid == myPid() && d.by == mail() && d.at is string
        && d.from in ['monthly', 'single'] && d.to in ['monthly', 'single'] && d.ym is string && d.note is string && d.note.size() <= 300;
    }
    function reqDone() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'reply', 'doneBy', 'doneAt'])
        && resource.data.st == 'open' && request.resource.data.st in ['ok', 'no'] && request.resource.data.doneBy == mail();
    }
    match /requests/{id} {
      allow read: if isCash() || ownsMid(resource.data.mid);
      allow create: if isPlayer() && reqPayOk(request.resource.data);
      allow update: if isCash() && resource.data.kind == 'pay' && !ownsMid(resource.data.mid) && reqDone();
      allow delete: if isCash() || (isPlayer() && resource.data.mid == myPid() && resource.data.st == 'open');
    }

    // ===== Pokladna: předpisy (události i měsíční příspěvky) čte vlastník (mid = jeho pid / tid) a správci; příjmy, výdaje, platy a audit jen správci =====
    // Člen musí předpisy číst dotazem s podmínkou mid == jeho pid / tid (aplikace to dělá)
    match /charges/{id} {
      allow read: if isCash() || ownsMid(resource.data.mid);
      allow write: if isCash();
    }
    // Souhrn dlužníků: dokument {mid, since, dues: [{d, x}]} BEZ částek (splatnosti nezaplacených předpisů a příznak výjimky).
    // Čtou všichni členové (značka ⛓ v Docházce), zapisuje jen správce pokladny ve stejné dávce jako změny předpisů; id dokumentu = mid
    match /debtors/{id} {
      allow read: if isMember();
      allow create, update: if isCash() && request.resource.data.mid == id
        && request.resource.data.keys().hasOnly(['mid', 'since', 'dues'])
        && request.resource.data.since is string && request.resource.data.dues is list;
      allow delete: if isCash();
    }
    match /cash/{id} { allow read, write: if isCash(); }
    // Audit log se jen přidává (nejde měnit ani mazat)
    match /audit/{id} {
      allow read: if isCash();
      allow create: if isCash();
    }
    // Ostatní kolekce (i neznámé) pravidla nepovolují – kdo je nemá výslovně uvedené výše, nečte ani nezapisuje.
  }
}
