rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Pomocné funkce =====
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function mail() { return request.auth.token.email.lower(); }
    function memberPath() { return /databases/$(database)/documents/members/$(mail()); }
    function isMember() { return signedIn() && exists(memberPath()); }
    function role() { return get(memberPath()).data.role; }
    // Role po převodu (members.role): manager / trener / asistent / hracka / host. Jiná (stará) hodnota nedává žádná správcovská práva.
    // isMgr = manager (členové, ✋ žádosti o přijetí, brána verze, účty pro QR, matice práv, mazání rozpočtu);
    // isRoster = manager a trener (soupiska a realizační tým – pevné buňky matice); isStaff = manager, trener, asistent (sport).
    function isMgr() { return isMember() && role() == 'manager'; }
    function isRoster() { return isMember() && role() in ['manager', 'trener']; }
    function isStaff() { return isMember() && role() in ['manager', 'trener', 'asistent']; }
    // Hostující (role host, hráčka 🎟 z jiného týmu): vidí jen sebe – vlastní hráčku, docházku, předpisy a veřejné dokumenty evpub / lineuppub.
    // isTeam = člen týmu kromě hostujícího; všechna čtení týmových kolekcí jsou jen pro isTeam().
    function isHost() { return isMember() && role() == 'host'; }
    function isTeam() { return isMember() && role() != 'host'; }
    // Správce pokladny: manager, nebo člen s příznakem cash (pokladník); hostující nikdy
    function isCash() { return isMember() && (role() == 'manager' || (role() != 'host' && get(memberPath()).data.get('cash', false) == true)); }
    // Hráčka (i hostující) smí zapisovat jen tehdy, když ji manager (nebo pokladník) propojil s hráčkou v soupisce (pole pid)
    function isPlayer() { return isMember() && role() in ['hracka', 'host'] && get(memberPath()).data.pid is string; }
    function myPid() { return get(memberPath()).data.pid; }
    // Předpis patří přihlášenému členovi (mid = jeho pid nebo tid)
    function ownsMid(mid) { return isMember() && (get(memberPath()).data.get('pid', '') == mid || get(memberPath()).data.get('tid', '') == mid); }
    // ===== Práva po modulech (matice settings/perm) =====
    // Role pro matici = uložená role (po převodu); stará hodnota se v matici nenajde, takže nedává žádné právo.
    function myRole() { return role(); }
    // Matice settings/perm = {v, roles: {trener|asistent|hracka: {modul: {r, e, c, d}}}, by, at}; chybějící dokument nebo hodnota = výchozí.
    // Výchozí matice = DEFAULT_PERMS z domain/permissions.js (shodu hlídá test tests/perm-matrix.test.js).
    function permPath() { return /databases/$(database)/documents/settings/perm; }
    function permDef() { return {
      'trener': {'events': {'r': true, 'e': true, 'c': true, 'd': true}, 'matches': {'r': true, 'e': true, 'c': true, 'd': true}, 'att': {'r': true, 'e': true, 'c': false, 'd': true}, 'lines': {'r': true, 'e': true, 'c': false, 'd': true}, 'roster': {'r': true, 'e': true, 'c': false, 'd': true}, 'staff': {'r': true, 'e': true, 'c': false, 'd': true}, 'opp': {'r': true, 'e': true, 'c': false, 'd': true}, 'stats': {'r': true, 'e': false, 'c': false, 'd': false}, 'attview': {'r': true, 'e': false, 'c': false, 'd': false}, 'members': {'r': false, 'e': false, 'c': false, 'd': false}, 'budget': {'r': false, 'e': false, 'c': false, 'd': false}, 'app': {'r': true, 'e': false, 'c': false, 'd': false}, 'drills': {'r': true, 'e': true, 'c': false, 'd': true}, 'trplan': {'r': true, 'e': true, 'c': false, 'd': false}, 'treval': {'r': true, 'e': true, 'c': false, 'd': false}},
      'asistent': {'events': {'r': true, 'e': true, 'c': true, 'd': true}, 'matches': {'r': true, 'e': true, 'c': true, 'd': true}, 'att': {'r': true, 'e': true, 'c': false, 'd': true}, 'lines': {'r': true, 'e': true, 'c': false, 'd': true}, 'roster': {'r': true, 'e': false, 'c': false, 'd': false}, 'staff': {'r': true, 'e': false, 'c': false, 'd': false}, 'opp': {'r': true, 'e': true, 'c': false, 'd': true}, 'stats': {'r': true, 'e': false, 'c': false, 'd': false}, 'attview': {'r': true, 'e': false, 'c': false, 'd': false}, 'members': {'r': false, 'e': false, 'c': false, 'd': false}, 'budget': {'r': false, 'e': false, 'c': false, 'd': false}, 'app': {'r': true, 'e': false, 'c': false, 'd': false}, 'drills': {'r': true, 'e': true, 'c': false, 'd': false}, 'trplan': {'r': true, 'e': true, 'c': false, 'd': false}, 'treval': {'r': true, 'e': true, 'c': false, 'd': false}},
      'hracka': {'events': {'r': true, 'e': false, 'c': false, 'd': false}, 'matches': {'r': true, 'e': false, 'c': false, 'd': false}, 'att': {'r': false, 'e': false, 'c': false, 'd': false}, 'lines': {'r': true, 'e': false, 'c': false, 'd': false}, 'roster': {'r': true, 'e': false, 'c': false, 'd': false}, 'staff': {'r': true, 'e': false, 'c': false, 'd': false}, 'opp': {'r': true, 'e': false, 'c': false, 'd': false}, 'stats': {'r': true, 'e': false, 'c': false, 'd': false}, 'attview': {'r': true, 'e': false, 'c': false, 'd': false}, 'members': {'r': false, 'e': false, 'c': false, 'd': false}, 'budget': {'r': false, 'e': false, 'c': false, 'd': false}, 'app': {'r': false, 'e': false, 'c': false, 'd': false}, 'drills': {'r': false, 'e': false, 'c': false, 'd': false}, 'trplan': {'r': true, 'e': false, 'c': false, 'd': false}, 'treval': {'r': false, 'e': false, 'c': false, 'd': false}}
    }; }
    function permSet(r, mod, act) { return exists(permPath()) ? get(permPath()).data.get(['roles', r, mod, act], null) : null; }
    function permVal(v, r, mod, act) { return v is bool ? v : permDef()[r][mod][act]; }
    function canAs(r, mod, act) { return r == 'manager' || (r in ['trener', 'asistent', 'hracka'] && permVal(permSet(r, mod, act), r, mod, act)); }
    // Smí přihlášený člen akci v modulu (r číst, e upravovat, c rušit, d mazat)? Manager vždy, hostující nikdy.
    function can(mod, act) { return isMember() && canAs(myRole(), mod, act); }
    // Úprava události / zápasu: pole cancelled = rušit (c), jen pole lines (pětky tréninku) = formace, ostatní pole = upravovat (e)
    function chKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function evUpdate(mod) {
      return (can(mod, 'e') && !chKeys().hasAny(['cancelled'])) || (can(mod, 'c') && chKeys().hasOnly(['cancelled']))
        || (can('lines', 'e') && chKeys().hasOnly(['lines']));
    }
    // Zápis matice: jen manager, tvar {v, roles, by, at}, role jen trener / asistent / hracka, by = jeho e-mail
    function permSettingsOk() {
      return isMgr() && request.resource.data.keys().hasOnly(['v', 'roles', 'by', 'at']) && request.resource.data.roles is map
        && request.resource.data.roles.keys().hasOnly(['trener', 'asistent', 'hracka']) && request.resource.data.get('by', mail()) == mail();
    }
    // Pole, které smí v dokumentu události / zápasu měnit i pokladník: příznak ss (vyúčtováno); náklady a vyúčtování jsou v evcash.
    function cashFieldsOnly() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ss']); }
    // Stará citlivá pole (dnes v soukromých kolekcích plpay, staffpay, attnote): nový dokument je nesmí obsahovat,
    // změna dokumentu je nesmí přidat ani změnit – smazat je jde.
    function noKeys(ks) { return !request.resource.data.keys().hasAny(ks); }
    function keepOut(ks) { return !request.resource.data.diff(resource.data).addedKeys().hasAny(ks) && !request.resource.data.diff(resource.data).changedKeys().hasAny(ks); }

    // ===== Účty týmu pro QR platby: princip čtyř očí =====
    // iban / iban2 = platné účty, ibanBy = kdo změnu navrhl, ibanOk = kdo ji potvrdil, ibanAt = kdy, ibanCode = kód potvrzených účtů,
    // ibanPend = čekající návrh {iban, iban2, code, by, at}.
    // Návrh smí podat jen manager (isMgr, pod svým e-mailem), potvrdit jen JINÝ správce pokladny a jen přesně navržené účty.
    function sNew(k) { return request.resource.data.get(k, ''); }
    function sOld(k) { return resource.data.get(k, ''); }
    function pendNew() { return request.resource.data.get('ibanPend', null); }
    function pendOld() { return resource.data.get('ibanPend', null); }
    // Kód účtu (v22.22): XXXX-XXXX nebo dvojice oddělená mezerou (hex). Navrhovatel ho spočítá z účtu na svém zařízení,
    // potvrzující ho přepíše a aplikace ho porovná s účty z návrhu; pravidla hlídají jen formát a shodu uložených hodnot.
    function codeOk(c) { return c is string && c.matches('^[0-9A-F]{4}-[0-9A-F]{4}( [0-9A-F]{4}-[0-9A-F]{4})?$'); }
    // ibanCode = kód potvrzených účtů (zapsaný při potvrzení z kódu návrhu); mění se jen spolu s účty
    function accSame() { return sNew('iban') == sOld('iban') && sNew('iban2') == sOld('iban2') && sNew('ibanBy') == sOld('ibanBy') && sNew('ibanOk') == sOld('ibanOk') && sNew('ibanAt') == sOld('ibanAt') && sNew('ibanCode') == sOld('ibanCode'); }
    // Návrh smí podat jen manager a musí nést kód účtů ve tvaru kódu
    function pendByMe() { return pendNew() != null && isMgr() && pendNew().by == mail() && codeOk(pendNew().get('code', '')); }
    function cashSettingsUpdate() {
      return isCash() && (
        (accSame() && pendNew() == pendOld())                     // běžná změna nastavení (účty beze změny)
        || (accSame() && pendNew() == null)                       // zrušení / zamítnutí návrhu
        || (accSame() && pendByMe())                              // nový návrh – jen manager
        || (pendOld() != null && pendNew() == null                // potvrzení jiným správcem přesně podle návrhu
            && pendOld().by != mail()
            && codeOk(pendOld().get('code', ''))                  // návrh musí nést kód (starý návrh bez kódu se jen zamítne)
            && sNew('iban') == pendOld().get('iban', '') && sNew('iban2') == pendOld().get('iban2', '')
            && sNew('ibanBy') == pendOld().by && sNew('ibanOk') == mail()
            && sNew('ibanCode') == pendOld().get('code', '')));
    }
    // Nový dokument nastavení pokladny: bez účtů, nejvýš s návrhem managera
    function cashSettingsCreate() {
      return isCash() && sNew('iban') == '' && sNew('iban2') == '' && sNew('ibanBy') == '' && sNew('ibanOk') == '' && sNew('ibanAt') == '' && sNew('ibanCode') == ''
        && (pendNew() == null || pendByMe());
    }

    // ===== Brána verze (settings/app): {minVer, minBy, minAt} – minimální verze aplikace, která smí zapisovat =====
    // Nastavuje jen manager (isMgr); minVer = číslo verze (např. 18.8), minBy = jeho e-mail. Dokument nejde smazat.
    function appSettingsOk() {
      return isMgr() && request.resource.data.keys().hasOnly(['minVer', 'minBy', 'minAt'])
        && request.resource.data.minVer is string && request.resource.data.minVer.matches('^[0-9]+([.][0-9]+){0,2}$')
        && request.resource.data.get('minBy', mail()) == mail();
    }

    // ===== 🧪 Beta testeři (settings/beta): {testers: [e-maily], by, at} – nejvýš 50 e-mailů =====
    // Mění manager nebo účet vývojáře (stejný seznam jako DEV_EMAILS v src/config/team-config.js); by = jeho e-mail. Dokument nejde smazat.
    function isDevAcct() { return signedIn() && mail() in ['tomaskre@gmail.com']; }
    function betaSettingsOk() {
      return (isMgr() || isDevAcct()) && request.resource.data.keys().hasOnly(['testers', 'by', 'at'])
        && request.resource.data.testers is list && request.resource.data.testers.size() <= 50
        && request.resource.data.by == mail();
    }

    // ===== Členové týmu: role, propojení (pid, tid) a příznak pokladníka (cash) =====
    // Manager spravuje všechny členy, převádí role a zapisuje rv. Pokladník jen členy s rolí hracka – před změnou i po ní –
    // a nikdy vlastní dokument (jinak by si mohl dát roli asistent a získat sportovní zápis). Posledního managera hlídá aplikace.
    function cashierMember(email, d) { return isCash() && email != mail() && d.role == 'hracka'; }
    match /members/{email} {
      allow read: if signedIn() && (email == mail() || isMgr() || isCash());
      allow create: if isMgr() || cashierMember(email, request.resource.data);
      allow update: if isMgr() || (cashierMember(email, request.resource.data) && cashierMember(email, resource.data));
      allow delete: if isMgr() || cashierMember(email, resource.data);
    }

    // ===== Soupiska: spravuje manager a trenér (isRoster); asistent smí měnit jen stav (st) =====
    // Platební pole (grp, fx, ex, note) jsou v plpay/{pid} (spravuje je správce pokladny); v soupisce je nejde zapsat, jen smazat.
    // Příznak guest (hostující 🎟) zapisuje manager nebo trenér; hostující čte jen svůj dokument.
    match /players/{id} {
      allow read: if isTeam() || (isHost() && id == myPid());
      allow create: if isRoster() && noKeys(['grp', 'fx', 'ex', 'note']);
      allow delete: if isRoster();
      allow update: if keepOut(['grp', 'fx', 'ex', 'note']) && (isRoster()
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st'])));
    }

    // ===== Realizační tým: čtou všichni členové, spravuje manager a trenér (isRoster) =====
    // Plat je ve staffpay/{tid} (spravuje ho správce pokladny); pole pay v dokumentu týmu nejde zapsat, jen smazat.
    match /staff/{id} {
      allow read: if isTeam();
      allow create: if isRoster() && noKeys(['pay']);
      allow delete: if isRoster();
      allow update: if isRoster() && keepOut(['pay']);
    }

    // ===== Zápasy, soupeři: podle matice práv (výchozí trenér i asistent); u zápasu smí pokladník měnit jen příznak ss. Číst smí členové týmu =====
    // Zrušení (pole cancelled) = akce rušit, smazání = mazat, ostatní změny = upravovat (evUpdate).
    match /matches/{id} {
      allow read: if isTeam();
      allow create: if can('matches', 'e');
      allow delete: if can('matches', 'd');
      allow update: if evUpdate('matches') || (isCash() && cashFieldsOnly());
    }
    match /opponents/{id} {
      allow read: if isTeam();
      allow create, update: if can('opp', 'e');
      allow delete: if can('opp', 'd');
    }

    // ===== Nastavení: základní formace manager, trenér a asistent, settings/cash (šablony, kategorie) správce pokladny; účty jen přes návrh a potvrzení;
    // settings/app (brána verze) jen manager; settings/perm (matice práv) jen manager; čtou členové týmu (ne hostující),
    // hostující jen cash (účet pro QR), events (sraz) a app; settings/beta (🧪 testeři) manager nebo vývojář. settings/cash, app ani beta nejde smazat =====
    match /settings/{id} {
      allow read: if isTeam() || (isHost() && id in ['cash', 'events', 'app']);
      allow create: if id == 'cash' ? cashSettingsCreate() : (id == 'app' ? appSettingsOk() : (id == 'perm' ? permSettingsOk() : (id == 'beta' ? betaSettingsOk() : isStaff())));
      allow update: if id == 'cash' ? cashSettingsUpdate() : (id == 'app' ? appSettingsOk() : (id == 'perm' ? permSettingsOk() : (id == 'beta' ? betaSettingsOk() : isStaff())));
      allow delete: if id != 'cash' && id != 'app' && id != 'beta' && (id == 'perm' ? isMgr() : isStaff());
    }

    // ===== Tréninky (události): čtou členové týmu, spravuje se podle matice práv (výchozí trenér a asistent); pokladník jen příznak ss =====
    // Zrušení (pole cancelled) = rušit, pětky (jen pole lines) = formace, smazání = mazat, ostatní změny = upravovat.
    match /events/{id} {
      allow read: if isTeam();
      allow create: if can('events', 'e');
      allow delete: if can('events', 'd');
      allow update: if evUpdate('events') || (isCash() && cashFieldsOnly());
    }

    // ===== Série tréninků (definice opakování): čtou členové, zapisuje kdo smí upravovat události; události série jsou v events (pole ser) =====
    match /series/{id} {
      allow read: if isTeam();
      allow create, update: if can('events', 'e');
      allow delete: if can('events', 'd');
    }

    // ===== 📚 Banka cvičení (modul Trénink): čte, zakládá / upravuje a maže se podle matice práv (modul drills); hostující nic =====
    // Dokument jen se známými poli; název 1–80 znaků, dovednosti a skupiny jako seznam, délka 1–60 min.
    function drillOk(d) {
      return d.keys().hasOnly(['name', 'cat', 'sk', 'lvl', 'dur', 'grp', 'eq', 'desc', 'url', 'pdf', 'img', 'meas', 'by', 'at', 'arch'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80 && d.cat is string && d.sk is list && d.grp is list
        && d.dur is int && d.dur >= 1 && d.dur <= 60 && (!('img' in d) || (d.img is list && d.img.size() <= 3));
    }
    match /drills/{id} {
      allow read: if can('drills', 'r');
      allow create, update: if can('drills', 'e') && drillOk(request.resource.data);
      allow delete: if can('drills', 'd');
    }
    // Obrázky cvičení drillimg/{id} = {d (data:URL zmenšeného obrázku), did, w, h, by, at}: čtou členové kromě hostující (obrázky v plánu
    // tréninku), zakládá, mění a maže, kdo smí upravovat banku cvičení (odebrání obrázku je úprava cvičení).
    function imgOk(d) {
      return d.keys().hasOnly(['d', 'did', 'w', 'h', 'by', 'at']) && d.d is string && d.d.size() <= 700000 && d.did is string;
    }
    match /drillimg/{id} {
      allow read: if isTeam();
      allow create, update: if can('drills', 'e') && imgOk(request.resource.data);
      allow delete: if can('drills', 'e');
    }

    // ===== 📋 Plán tréninku trplan/{eid} (id = id tréninku): čte se a upravuje podle matice práv (modul trplan); hostující nic =====
    // Celý dokument patří aplikaci (bloky, linky, skupiny, trenéři); poznámky trenérů v něm nejsou – hráčka plán čte celý.
    function trplanOk(d) {
      return d.keys().hasOnly(['v', 'goal', 'blocks', 'by', 'at']) && d.blocks is list && d.blocks.size() <= 30
        && (!('goal' in d) || (d.goal is string && d.goal.size() <= 200));
    }
    match /trplan/{id} {
      allow read: if can('trplan', 'r');
      allow create, update: if can('trplan', 'e') && trplanOk(request.resource.data);
      allow delete: if can('trplan', 'e');
    }

    // ===== 📑 Šablony plánu tréninku trtpl/{id}: sdílené pro tým, čte a spravuje ten, kdo smí upravovat plán (modul trplan, e) =====
    // Dokument jako plán (bez trenérů a skupin stanovišť) + název 1–60 znaků.
    function trtplOk(d) {
      return d.keys().hasOnly(['v', 'name', 'goal', 'blocks', 'by', 'at']) && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.blocks is list && d.blocks.size() <= 30 && (!('goal' in d) || (d.goal is string && d.goal.size() <= 200));
    }
    match /trtpl/{id} {
      allow read: if can('trplan', 'e');
      allow create, update: if can('trplan', 'e') && trtplOk(request.resource.data);
      allow delete: if can('trplan', 'e');
    }

    // ===== ⏱ Živý trénink trlive/{eid} (id = id tréninku): společné hodiny – čte, kdo smí číst plán, řídí, kdo smí plán upravovat =====
    // adj {id bloku: min} a skip [id bloku] = úpravy jen pro tento průběh (vypustit / zkrátit blok), plán trplan se nemění
    // {v, st (run / pause / end), e0 (s od začátku plánu), wAt (čas zařízení), sAt (čas serveru = čas zápisu), ctl (řídící = zapisující), by, at}
    function trliveOk(d) {
      return d.keys().hasOnly(['v', 'st', 'e0', 'wAt', 'sAt', 'ctl', 'adj', 'skip', 'by', 'at']) && d.st in ['run', 'pause', 'end']
        && d.e0 is number && d.e0 >= 0 && d.e0 <= 21600 && d.sAt == request.time && d.ctl == mail()
        && (!('adj' in d) || (d.adj is map && d.adj.size() <= 30)) && (!('skip' in d) || (d.skip is list && d.skip.size() <= 30));
    }
    match /trlive/{id} {
      allow read: if can('trplan', 'r');
      allow create, update: if can('trplan', 'e') && trliveOk(request.resource.data);
      allow delete: if can('trplan', 'e');
    }

    // ===== ⏲ Výsledky měření trms/{eid} (id = id tréninku): stopky, počty a body – výsledky vidí, kdo čte plán (celý tým kromě hostující),
    // zapisuje, kdo smí měřit (modul treval, e). {v, r: {blok_linka: {d, dn, u, low, ms: {id hráčky: [pokusy]}}}, by, at}
    function trmsOk(d) {
      return d.keys().hasOnly(['v', 'r', 'by', 'at']) && d.r is map && d.r.size() <= 120 && d.get('by', mail()) == mail();
    }
    match /trms/{id} {
      allow read: if can('trplan', 'r');
      allow create, update: if can('treval', 'e') && trmsOk(request.resource.data);
      allow delete: if can('treval', 'e');
    }

    // ===== ⭐ Hodnocení cvičení treval/{eid} (id = id tréninku): poznámky trenérů – čte jen realizační tým podle matice (treval, r;
    // hráčka ani hostující ne), zapisuje, kdo smí hodnotit (treval, e). {v, r: {blok_linka: {d, dn, r (0–4), n, pl: {id hráčky: {r, n}}}}, by, at}
    function trevalOk(d) {
      return d.keys().hasOnly(['v', 'r', 'by', 'at']) && d.r is map && d.r.size() <= 120 && d.get('by', mail()) == mail();
    }
    // v22.35: navíc jen realizační tým (isStaff) – hráčka hodnocení trenérů nikdy, ani po omylu v matici práv
    match /treval/{id} {
      allow read: if can('treval', 'r') && isStaff();
      allow create, update: if can('treval', 'e') && isStaff() && trevalOk(request.resource.data);
      allow delete: if can('treval', 'e') && isStaff();
    }

    // ===== ✏️ Skutečný průběh tréninku tract/{eid} (id = id tréninku): délky a vypuštěné bloky proti plánu pro statistiky =====
    // Čte, kdo smí číst plán (hráčka kvůli Můj trénink), zapisuje, kdo smí plán upravovat. {v: 1, blocks: [{id, dur, skip}], src: live | edit, by, at}
    function tractOk(d) {
      return d.keys().hasOnly(['v', 'blocks', 'src', 'by', 'at']) && d.v == 1 && d.blocks is list && d.blocks.size() <= 30
        && d.src in ['live', 'edit'] && d.get('by', mail()) == mail();
    }
    match /tract/{id} {
      allow read: if can('trplan', 'r');
      allow create, update: if can('trplan', 'e') && tractOk(request.resource.data);
      allow delete: if can('trplan', 'e');
    }

    // ===== ⭐ Výkonnost hráček plevel/team: jen realizační tým (hráčky ani hostující ji nečtou) =====
    // {v, lv: {id hráčky: 1–5}, by, at} – podklad pro rozdělení do pětek tréninku
    function plevelOk(d) {
      return d.keys().hasOnly(['v', 'lv', 'by', 'at']) && d.lv is map && d.lv.size() <= 200;
    }
    match /plevel/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && plevelOk(request.resource.data);
      allow delete: if isRoster();
    }

    // ===== Vyúčtování událostí (náklady, kdo platí, snapshot): jen správci pokladny; id = id události nebo zápasu =====
    match /evcash/{id} { allow read, write: if isCash(); }
    // Cena uzavřené události na hlavu evprice/{id} = {ym, date, tpl, head: {monthly, single, exempt}} (před koeficientem, 0 = skupina neplatí):
    // čte každý člen (Moje platby – porovnání způsobu placení), zapisuje správce pokladny; celkové náklady ani dodavatelé tu nejsou
    function priceOk(d) { return d.keys().hasOnly(['ym', 'date', 'tpl', 'head']) && d.ym is string && d.date is string && d.tpl is string && d.head is map; }
    match /evprice/{id} {
      allow read: if isMember();
      allow create, update: if isCash() && priceOk(request.resource.data);
      allow delete: if isCash();
    }

    // ===== Rozpočet sezóny budget/{sezóna} (id "RRRR-RR", období 1. 8. – 30. 6.): čte a zapisuje jen správce pokladny =====
    // Pole plánu (parametry, položky, platy, ostatní), kdo / kdy uložil, schválení approved = {data, sum, by, at} a úpravy rev (seznam);
    // sezóna v dokumentu musí odpovídat id. Schválenou verzi nejde změnit ani odebrat, úpravy jen přidávat; smazat jde jen neschválený (manager).
    function budgetOk(id, d) { return d.keys().hasOnly(['season', 'par', 'items', 'sal', 'other', 'by', 'at', 'approved', 'rev']) && d.season == id && d.par is map && d.items is list && d.sal is list && d.other is list
      && (!('approved' in d) || (d.approved is map && d.approved.keys().hasOnly(['data', 'sum', 'by', 'at']) && d.approved.data is map))
      && (!('rev' in d) || d.rev is list); }
    // v22.35: starší úpravy rev musí zůstat beze změny (seznam jde jen prodloužit na konci)
    function budgetKeep(o, d) { return (!('approved' in o) || (('approved' in d) && d.approved == o.approved))
      && (!('rev' in o) || (('rev' in d) && d.rev.size() >= o.rev.size() && d.rev[0:o.rev.size()] == o.rev)); }
    match /budget/{id} {
      allow read: if isCash();
      allow create: if isCash() && id.matches('^[0-9]{4}-[0-9]{2}$') && budgetOk(id, request.resource.data);
      allow update: if isCash() && id.matches('^[0-9]{4}-[0-9]{2}$') && budgetOk(id, request.resource.data) && budgetKeep(resource.data, request.resource.data);
      allow delete: if isMgr() && !('approved' in resource.data);
    }

    // ===== Docházka: dokument {eid}_{pid} s poli eid, pid, st, at, by =====
    // Důvod omluvy je v attnote/{eid}_{pid}; pole reason v docházce nejde zapsat, jen smazat (čte ji každý člen).
    // pid je hráčka nebo člen realizačního týmu. Manager, trenér a asistent zapisují za kohokoli; hráčka jen svůj dokument (pid z jejího členství, id = eid_pid)
    // Docházka: odpověď st; nos = 🚫 nedorazila bez omluvy – nastavuje a ruší jen manager / trenér / asistent, hráčka značku nezaloží, nezmění ani nesmaže
    // abs = id 🏖 nepřítomnosti, ze které omluva vznikla (zapisuje ji vlastník i manager / trenér / asistent). Hostující čte jen své odpovědi.
    function nosKeep() { return request.resource.data.get('nos', null) == resource.data.get('nos', null); }
    match /attendance/{id} {
      allow read: if isTeam() || (isHost() && resource.data.pid == myPid());
      allow create: if noKeys(['reason']) && (isStaff() || (isPlayer() && noKeys(['nos'])
        && request.resource.data.pid == myPid()
        && id == request.resource.data.eid + '_' + myPid()));
      allow update: if keepOut(['reason']) && (isStaff() || (isPlayer() && nosKeep()
        && request.resource.data.pid == myPid()
        && id == request.resource.data.eid + '_' + myPid()));
      allow delete: if isStaff() || (isPlayer() && resource.data.pid == myPid() && !('nos' in resource.data));
    }

    // ===== 🕘 Historie přihlášek attlog/{id} (náhodné id): jen přidávání, záznam nejde změnit =====
    // {eid, pid, st, by, bp, src, at}: st = yes / no / maybe / del (zrušeno) / nos / nos0 (🚫 označeno / zrušeno); by = e-mail zapisujícího účtu,
    // bp = jeho osoba (pid nebo tid z členství, prázdné bez osoby), src = abs / req / auto (prázdné = ruční), at = čas serveru.
    // Zakládá manager, trenér a asistent za kohokoli, hráčka a hostující jen za sebe. Čte manager, trenér a asistent; mazat smí jen manager.
    function logBp(d) { return d.bp in [get(memberPath()).data.get('pid', ''), get(memberPath()).data.get('tid', '')]; }
    function logOk(d) {
      return d.keys().hasOnly(['eid', 'pid', 'st', 'by', 'bp', 'src', 'at']) && d.eid is string && d.pid is string && d.bp is string
        && d.st in ['yes', 'no', 'maybe', 'del', 'nos', 'nos0'] && d.get('src', '') in ['', 'abs', 'req', 'auto']
        && d.by == mail() && d.at == request.time && logBp(d);
    }
    match /attlog/{id} {
      allow read: if isStaff();
      allow create: if logOk(request.resource.data) && (isStaff() || (isPlayer() && request.resource.data.pid == myPid()));
      allow delete: if isMgr();
    }

    // ===== Soukromé kolekce: citlivá data čte jen vlastník a správci =====
    // Důvod omluvy attnote/{eid}_{mid} = {eid, mid, reason} (zdravotní údaje): čte vlastník (mid = jeho pid / tid) a manager / trenér / asistent.
    // Zapisuje manager, trenér a asistent za kohokoli, hráčka jen svůj (mid z jejího členství); id = eid_mid, jen tato tři pole.
    function noteOk(id, d) { return d.keys().hasOnly(['eid', 'mid', 'reason']) && d.reason is string && id == d.eid + '_' + d.mid; }
    match /attnote/{id} {
      allow read: if isStaff() || ownsMid(resource.data.mid);
      allow create, update: if noteOk(id, request.resource.data) && (isStaff() || (isPlayer() && request.resource.data.mid == myPid()));
      allow delete: if isStaff() || (isPlayer() && resource.data.mid == myPid());
    }
    // Plat člena realizačního týmu staffpay/{tid} = {m, amt}: čte a zapisuje správce pokladny, číst smí i člen sám (tid z členství)
    match /staffpay/{id} {
      allow read: if isCash() || ownsMid(id);
      allow create, update: if isCash() && request.resource.data.keys().hasOnly(['m', 'amt']);
      allow delete: if isCash();
    }
    // Platební pole hráčky plpay/{pid} = {grp, fx, ex, note, grpH}: čte a zapisuje správce pokladny, číst smí i hráčka sama (pid z členství)
    // a člen realizačního týmu, který je zároveň hráčkou (pid v members u role manager / trener / asistent);
    // grpH = historie způsobu placení [{ym, grp}] (seznam)
    match /plpay/{id} {
      allow read: if isCash() || (isPlayer() && id == myPid()) || (isStaff() && get(memberPath()).data.get('pid', '') == id);
      allow create, update: if isCash() && request.resource.data.keys().hasOnly(['grp', 'fx', 'ex', 'note', 'grpH']) && request.resource.data.get('grpH', []) is list;
      allow delete: if isCash();
    }

    // ===== Žádosti členů requests/{id} (kind "pay" = změna způsobu placení, kind "att" = změna účasti po uzávěrce) =====
    // Hráčka vytvoří jen vlastní otevřenou žádost o placení pod svým e-mailem a smí ji smazat (zrušit), dokud je otevřená.
    // Žádost o změnu účasti podá člen (hráčka, hostující, člen týmu) za sebe (mid = jeho pid / tid); vyřizuje ji manager / trenér / asistent.
    // Čte vlastník, správce pokladny a u žádostí o účast manager / trenér / asistent; vyřízení jen otevřené žádosti:
    // mění pouze st (ok / no), reply, doneBy (jeho e-mail), doneAt.
    function reqPayOk(d) {
      return d.keys().hasOnly(['kind', 'mid', 'at', 'by', 'st', 'from', 'to', 'ym', 'note'])
        && d.kind == 'pay' && d.st == 'open' && d.mid == myPid() && d.by == mail() && d.at is string
        && d.from in ['monthly', 'single'] && d.to in ['monthly', 'single'] && d.ym is string && d.note is string && d.note.size() <= 300;
    }
    function reqAttOk(d) {
      return d.keys().hasOnly(['kind', 'mid', 'at', 'by', 'st', 'eid', 'want', 'reason', 'abs'])
        && d.kind == 'att' && d.st == 'open' && ownsMid(d.mid) && d.by == mail() && d.at is string && d.eid is string
        && d.want in ['yes', 'no', 'maybe'] && d.reason is string && d.reason.size() <= 300 && d.get('abs', '') is string;
    }
    function reqDone() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'reply', 'doneBy', 'doneAt'])
        && resource.data.st == 'open' && request.resource.data.st in ['ok', 'no'] && request.resource.data.doneBy == mail();
    }
    match /requests/{id} {
      allow read: if isCash() || ownsMid(resource.data.mid) || (isStaff() && resource.data.kind == 'att');
      allow create: if (isPlayer() && reqPayOk(request.resource.data)) || reqAttOk(request.resource.data);
      allow update: if (isCash() && resource.data.kind == 'pay' && !ownsMid(resource.data.mid) && reqDone())
        || (isStaff() && resource.data.kind == 'att' && reqDone());
      allow delete: if isCash() || (isStaff() && resource.data.kind == 'att') || (ownsMid(resource.data.mid) && resource.data.st == 'open');
    }

    // ===== 🏖 Nepřítomnost člena absence/{id} = {mid, kind, from, to, note, by, at} (druh nemoc = zdravotní údaj) =====
    // Čte vlastník (mid = jeho pid / tid) a manager / trenér / asistent; zakládá, mění a maže vlastník za sebe (by = jeho e-mail),
    // manager / trenér / asistent za kohokoli (i obnova ze zálohy s původním by).
    function absOk(d) {
      return d.keys().hasOnly(['mid', 'kind', 'from', 'to', 'note', 'by', 'at']) && d.mid is string && d.kind in ['vac', 'sick', 'other']
        && d.from is string && d.to is string && d.from <= d.to && d.note is string && d.note.size() <= 300 && d.by is string && d.at is string;
    }
    function absMine(d) { return ownsMid(d.mid) && d.by == mail(); }
    match /absence/{id} {
      allow read: if isStaff() || ownsMid(resource.data.mid);
      allow create: if absOk(request.resource.data) && (isStaff() || absMine(request.resource.data));
      allow update: if absOk(request.resource.data) && (isStaff() || (ownsMid(resource.data.mid) && absMine(request.resource.data)));
      allow delete: if isStaff() || ownsMid(resource.data.mid);
    }

    // ===== Veřejné dokumenty pro hostující (zapisuje aplikace managera / trenéra / asistenta, views/auto-sync.js) =====
    // evpub/{id} = hlavička události bez odpovědí, nákladů a statistik – čte každý člen včetně hostujících.
    // lineuppub/{id} = pětky / formace jako jména – čtou členové týmu a hostující jen u události, kde má odpověď „Jdu“.
    function pubOk(d) { return d.keys().hasOnly(['k', 'date', 'time', 'place', 'dl', 'meet', 'title', 'end', 'note', 'opp', 'home', 'cancelled']) && d.k in ['t', 'm'] && d.date is string; }
    function attPath(eid) { return /databases/$(database)/documents/attendance/$(eid + '_' + myPid()); }
    function hostGoing(eid) { return isHost() && exists(attPath(eid)) && get(attPath(eid)).data.st == 'yes'; }
    match /evpub/{id} {
      allow read: if isMember();
      allow create, update: if isStaff() && pubOk(request.resource.data);
      allow delete: if isStaff();
    }
    match /lineuppub/{id} {
      allow read: if isTeam() || hostGoing(id);
      allow create, update: if isStaff() && request.resource.data.keys().hasOnly(['k', 'date', 'rows']) && request.resource.data.rows is list;
      allow delete: if isStaff();
    }

    // ===== Žádosti o přijetí do týmu joinreq/{email} (id = e-mail účtu Google malými písmeny) =====
    // Založit smí jen přihlášený účet BEZ členství a jen sám za sebe, jen pole formuláře se st 'open'. Po vyřízení managerem
    // (zamítnutí, odebraný přístup) smí poslat novou žádost nejdřív 24 h po vyřízení (doneMs). Čte vlastník a manager;
    // vyřizuje (st, reply, doneBy, doneMs, pid / tid) a maže manager, uchazeč smí smazat (zrušit) jen otevřenou žádost.
    function joinForm(email, d) {
      return d.keys().hasOnly(['email', 'nick', 'num', 'kind', 'note', 'st', 'at'])
        && d.email == email && d.st == 'open' && d.at is string
        && d.nick is string && d.nick.size() > 0 && d.nick.size() <= 40
        && d.num is string && d.num.matches('^([1-9][0-9]?)?$')
        && d.kind in ['hracka', 'staff'] && d.note is string && d.note.size() <= 300;
    }
    function joinOwner(email) { return signedIn() && email == mail() && !isMember(); }
    match /joinreq/{email} {
      allow read: if signedIn() && (email == mail() || isMgr());
      allow create: if joinOwner(email) && joinForm(email, request.resource.data);
      allow update: if isMgr() || (joinOwner(email) && resource.data.st in ['no', 'ok']
        && request.time.toMillis() > resource.data.get('doneMs', 0) + 86400000 && joinForm(email, request.resource.data));
      allow delete: if isMgr() || (signedIn() && email == mail() && resource.data.st == 'open');
    }

    // ===== Pokladna: předpisy (události i měsíční příspěvky) čte vlastník (mid = jeho pid / tid) a správci; příjmy, výdaje, platy a audit jen správci =====
    // Člen musí předpisy číst dotazem s podmínkou mid == jeho pid / tid (aplikace to dělá)
    match /charges/{id} {
      allow read: if isCash() || ownsMid(resource.data.mid);
      allow write: if isCash();
    }
    // Souhrn dlužníků: dokument {mid, since, dues: [{d, x}]} BEZ částek (splatnosti nezaplacených předpisů a příznak výjimky).
    // Čtou členové týmu (značka ⛓ v Docházce), zapisuje jen správce pokladny ve stejné dávce jako změny předpisů; id dokumentu = mid
    match /debtors/{id} {
      allow read: if isTeam();
      allow create, update: if isCash() && request.resource.data.mid == id
        && request.resource.data.keys().hasOnly(['mid', 'since', 'dues'])
        && request.resource.data.since is string && request.resource.data.dues is list;
      allow delete: if isCash();
    }
    match /cash/{id} { allow read, write: if isCash(); }
    // Audit log se jen přidává (nejde měnit ani mazat)
    match /audit/{id} {
      allow read: if isCash();
      allow create: if isCash();
    }
    // ===== 🟢 Aktivita účtu: seen/{e-mail} = {at, v, ch} =====
    // Zapisuje jen vlastník (dokument podle e-mailu účtu, člen týmu i hostující), čas = čas serveru, verze a kanál; čte a maže jen manager.
    function seenOk(email, d) {
      return email == mail() && d.keys().hasOnly(['at', 'v', 'ch']) && d.at == request.time
        && d.v is string && d.v.size() <= 12 && d.ch in ['s', 'b'];
    }
    match /seen/{email} {
      allow read, delete: if isMgr();
      allow create, update: if isMember() && seenOk(email, request.resource.data);
    }
    // Ostatní kolekce (i neznámé) pravidla nepovolují – kdo je nemá výslovně uvedené výše, nečte ani nezapisuje.
  }
}
